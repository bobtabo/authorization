@startuml
' docs/architecture/backend.puml のフロントエンド版
' Feature-Based Architecture + Custom Hooks 構成（#140〜#143 で導入）を層構造として可視化
' 主フローは上→下。各層内は左→右（Auth→Client→Staff）で視線は左上→右下に近い
skinparam shadowing true
skinparam roundcorner 12
skinparam BoxPadding 8
skinparam nodesep 36
skinparam ranksep 48
top to bottom direction

skinparam defaultFontColor #1E293B
skinparam ArrowColor #475569
skinparam ArrowThickness 1.3

skinparam package {
    BorderColor #64748B
    FontColor #0F172A
    FontStyle bold
    FontSize 13
}

skinparam component<<Route>> {
    BackgroundColor #DBEAFE
    BorderColor #6366F1
    FontColor #1E1B4B
}
skinparam component<<Component>> {
    BackgroundColor #FCE7F3
    BorderColor #DB2777
    FontColor #831843
}
skinparam component<<Hook>> {
    BackgroundColor #A5F3FC
    BorderColor #0891B2
    FontColor #164E63
}
skinparam component<<Entity>> {
    BackgroundColor #FDE68A
    BorderColor #D97706
    FontColor #78350F
}
skinparam component<<Repository>> {
    BackgroundColor #EDE9FE
    BorderColor #7C3AED
    FontColor #4C1D95
}
skinparam component<<Infra>> {
    BackgroundColor #E2E8F0
    BorderColor #475569
    FontColor #1E293B
}
skinparam cloud<<Store>> {
    BackgroundColor #ECFDF5
    BorderColor #059669
    FontColor #064E3B
}

skinparam folder {
    BackgroundColor #FEF3C7
    BorderColor #D97706
    FontColor #78350F
}

' 凡例（実ディレクトリとの対応）
' Route      = app/**/page.tsx（薄いラッパー。ロジックを持たずViewを呼ぶだけ）
' Component  = features/*/components/*.tsx（View。見た目のみ）
' Hook       = features/*/hooks/*.ts（Application/UseCase。状態管理・API呼び出し）
' Entity     = features/*/types.ts（Value Object・定数）
' Repository = features/*/api.ts（バックエンドAPIとの契約。関数のみでinterface/impl分離はない）
' Infra      = shared/api/http.ts・client.ts・auth.ts・gate.ts・notifications.ts・invitation.ts
' Store      = 各バックエンド（PHP Laravel 等、nginx-proxy 経由の複数ランタイム）

package "1. Presentation Layer" #E0E7FF {
    folder "Auth" {
        [Auth Route] <<Route>>
        [Auth View] <<Component>>
        [Auth Route] -down-> [Auth View]
    }
    folder "Client" {
        [Client Route] <<Route>>
        [Client View] <<Component>>
        [Client Route] -down-> [Client View]
    }
    folder "Staff" {
        [Staff Route] <<Route>>
        [Staff View] <<Component>>
        [Staff Route] -down-> [Staff View]
    }
    "Auth" -[hidden]right- "Client"
    "Client" -[hidden]right- "Staff"
}

package "2. Application Layer" #CFFAFE {
    [Auth Hook] <<Hook>>
    [Client Hook] <<Hook>>
    [Staff Hook] <<Hook>>
    [Auth Hook] -[hidden]right- [Client Hook]
    [Client Hook] -[hidden]right- [Staff Hook]
}

package "3. Domain Layer" #FFFBEB {
    folder "Client Domain" {
        [Client Types] <<Entity>>
        [Client Api] <<Repository>>
    }
    folder "Staff Domain" {
        [Staff Types] <<Entity>>
        [Staff Api] <<Repository>>
    }
    "Client Domain" -[hidden]right- "Staff Domain"
}

package "4. Infrastructure Layer" #F1F5F9 {
    [Shared API / HTTP Client] <<Infra>>
}

cloud "Backend API\n(nginx-proxy 経由・複数ランタイム)" as backendApi <<Store>>

[Auth View] -down-> [Auth Hook]
[Client View] -down-> [Client Hook]
[Staff View] -down-> [Staff Hook]

[Client Hook] -down-> "Client Domain"
[Staff Hook] -down-> "Staff Domain"

' Auth は features/auth 専用の Repository(api.ts) を持たず、shared/api/auth.ts を直接呼ぶ
' （セッション管理・ヘッダー等アプリ全体から使う横断的関心事のため。#143 の設計判断）
[Auth Hook] -down-> [Shared API / HTTP Client]
note right of [Auth Hook]
  features/auth は専用の Repository(api.ts) を持たない。
  shared/api/auth.ts を直接呼ぶ（セッション管理・ヘッダー等アプリ全体から
  使う横断的関心事のため、featureに閉じない設計）。
end note

[Client Api] -down-> [Shared API / HTTP Client]
[Staff Api] -down-> [Shared API / HTTP Client]

[Shared API / HTTP Client] -down-> backendApi

@enduml
