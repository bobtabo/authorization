# 環境名
APP_ENV=local
# サーバーポート
APP_PORT=8080
# フロントエンドURL（CORS許可 + Googleリダイレクト先）
FRONTEND_URL=http://localhost:3000
# クッキー有効期間（分）
STAFF_COOKIE_LIFETIME=60
# 通知一覧のデフォルト取得件数
NOTIFICATION_DEFAULT_LIMIT=10
# キャッシュキーのプレフィックス
CACHE_PREFIX=authorization-gateway

# DB接続情報（開発用: host.docker.internal）
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=authorization
DB_USERNAME=develop
DB_PASSWORD="docker#DOCKER1234"

# Redis接続情報（開発用: host.docker.internal）
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Google OAuth2設定
APP_RUNTIME=go-beego
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URL=http://localhost:3000/function/go-beego/auth/google/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URL=http://localhost:3000/auth/github/callback

# Gate JWT キャッシュ有効期間（秒）
GATE_JWT_CACHE_TTL=1800

# メール送信設定
APP_NAME="Authorization Gateway"
#MAIL_HOST=mailpit
#MAIL_PORT=1025
#MAIL_USERNAME=
#MAIL_PASSWORD=
MAIL_FROM_ADDRESS="your-from-address@example.com"

# AWS SES
AWS_REGION=ap-northeast-1
AWS_ENDPOINT_URL=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
