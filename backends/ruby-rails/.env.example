# アプリ名
APP_NAME="Authorization Gateway"

# 環境名
APP_ENV=local

# デバッグ表示
APP_DEBUG=true

# アプリURL
APP_URL=https://apis.authorization-rails.dev

# サーバーポート
APP_PORT=3000

# タイムゾーン
APP_TIMEZONE=Asia/Tokyo

# ログ情報
LOG_LEVEL=debug

# DB接続情報
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=authorization
DB_USERNAME=develop
DB_PASSWORD="docker#DOCKER1234"

# Redis接続情報
REDIS_HOST=host.docker.internal
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0

# メール設定
#MAIL_HOST=mailpit
#MAIL_PORT=1025
#MAIL_USERNAME=
#MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"

# フロントエンドURL
FRONTEND_URL=http://localhost:3000

# アプリランタイム識別子
APP_RUNTIME=rb-rails

# OAuth2クライアント設定
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URL=http://localhost:3000/function/rails/auth/google/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URL=http://localhost:3000/auth/github/callback

# キャッシュPrefix
CACHE_PREFIX=authorization-gateway

# クッキー有効期間（分）
STAFF_COOKIE_LIFETIME=60

# 通知一覧のデフォルト取得件数
NOTIFICATION_DEFAULT_LIMIT=10

# JWT キャッシュ有効期間（秒）
GATE_JWT_CACHE_TTL=1800

# AWS SES
AWS_REGION=ap-northeast-1
AWS_ENDPOINT_URL=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
