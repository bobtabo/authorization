# LocalStack 環境用テンプレート
# {api-id} は tflocal apply 時に自動解決され frontend/.env.local が生成される
#
# 自動生成:
#   cd infra && make apply     … apply 完了後に .env.local が自動生成される
#   cd infra && make setup-env … .env.local の再生成のみ行う
#
# 手動生成:
#   cp .env.localstack .env.local
#   API_GATEWAY_ID=$(cd ../infra && tflocal output -raw api_gateway_id)
#   sed -i "s/{api-id}/${API_GATEWAY_ID}/g" .env.local

# LocalStack API Gateway 経由でバックエンドへ接続
NEXT_PUBLIC_API_URL=http://localhost:4566/restapis/{api-id}/local/_user_request_/function/php/api

# LocalStack API Gateway をプロキシ先に設定
LAMBDA_PROXY_TARGET=http://localhost:4566/restapis/{api-id}/local/_user_request_

# PostcodeJP API
NEXT_PUBLIC_POSTCODE_API_KEY=your-postcode-api-key
